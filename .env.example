# FinTrak environment variables
# Copy to .env and fill in real values: cp .env.example .env

# --- PostgreSQL (used by docker-compose.prod.yml) ---
POSTGRES_DB=fintrak
POSTGRES_USER=fintrak
POSTGRES_PASSWORD=change-me

# --- Backend ---
# Runtime environment: "production" (what an unset APP_ENV means) or
# "development". Only those two values are accepted; any other value stops the
# backend at startup instead of silently falling back to the development JWT
# secret and encryption key.
#
# Unset fails closed to production, which is what makes JWT_SECRET and
# TOKEN_ENCRYPTION_KEY mandatory (and subject to the minimum-length/entropy
# check) and the session cookie Secure by default — the production compose
# stacks set it for you. Set APP_ENV=development to run the dev stack on the
# built-in development secrets.
APP_ENV=

# Full connection string. Use "db:5432" as host when running inside compose,
# otherwise the host/port of your database.
#
# For an EXTERNAL database, require TLS with full verification, e.g.:
#   DATABASE_URL=postgres://user:pass@db.example.com:5432/fintrak?sslmode=verify-full&sslrootcert=/etc/fintrak/db-ca.pem
# (sslmode=disable is only appropriate for the private bundled-database network.)
DATABASE_URL=postgres://fintrak:change-me@db:5432/fintrak?sslmode=disable

# Secret used to sign auth tokens. Set a long random value, e.g.
#   openssl rand -hex 32
JWT_SECRET=

# Key used to encrypt per-user Paperless-ngx API tokens at rest. Set a long
# random value, e.g. `openssl rand -hex 32`; required when APP_ENV=production.
TOKEN_ENCRYPTION_KEY=

# Comma-separated list of origins allowed to call the API. Must include the
# exact origin(s) the frontend is served from, e.g. https://fintrak.example.com
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Base URL of the standalone statement-parser service. The backend forwards
# uploaded statement PDFs to this service over HTTP for decoupling.
STATEMENT_PARSER_URL=http://localhost:5000

# Comma-separated list of emails that are granted the 'admin' role (required to
# create/edit/delete global account types). Matched case-insensitively.
# Admin-listed addresses are reserved: self-registering one grants 'admin' only
# when the request also carries the ADMIN_SETUP_TOKEN below. Accounts are never
# promoted automatically at startup — this is the only role-granting path.
ADMIN_EMAILS=

# Shared secret required to self-register an admin-listed email (see
# ADMIN_EMAILS). Generate with: openssl rand -hex 16
# While unset, admin-listed addresses cannot self-register at all.
ADMIN_SETUP_TOKEN=

# Log level for the backend: debug, info, warn, or error. Defaults to "debug"
# in development (captures HTTP request/response bodies) and "info" in
# production.
LOG_LEVEL=

# Marks the httpOnly session cookie Secure (HTTPS-only). Defaults to true when
# APP_ENV=production. Set to false only for an isolated plain-HTTP deployment
# with no TLS terminator; otherwise the browser will not store the cookie and
# login will appear to succeed but the session won't persist.
COOKIE_SECURE=

# Byte cap for HTTP request/response bodies written to the log at debug level.
# Defaults to 0, which captures no bodies at all. Set a positive value (e.g.
# 8192) to enable capture, capped at that many bytes per body; non-positive
# values always mean "no capture", never "unlimited".
LOG_BODY_LIMIT=

# Comma-separated proxy CIDRs whose X-Forwarded-For / X-Real-IP headers the
# backend trusts. Empty means no proxy is trusted, so forwarded headers from a
# direct client are ignored and cannot spoof the per-IP auth rate-limit key;
# set this to your TLS terminator's network when one is in front of the backend.
#
# Comma-separated, and the two production Compose files distinguish UNSET from
# EMPTY: with this variable unset they default it to their pinned `app-net`
# subnet, because the frontend nginx is the only ingress there and without it
# every browser would share one auth rate-limit bucket. An explicitly empty
# value (`TRUSTED_PROXIES=`) really does mean "trust no proxy" — only correct
# when nothing proxies to the backend. Leave the line commented out to take the
# Compose default; uncomment and fill it in to name your own terminator's
# network.
# TRUSTED_PROXIES=

# --- Docker images (used by docker-compose.prod*.yml) ---
# Registry prefix and image tag to deploy. Images are published to GHCR.
IMAGE_REPO=ghcr.io/your-org
# Released tag to deploy (e.g. v1.2.3). Required by the production compose files;
# there is intentionally no "latest" default so redeploys are reproducible.
IMAGE_TAG=
