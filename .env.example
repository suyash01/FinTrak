# FinTrak environment variables
# Copy to .env and fill in real values: cp .env.example .env

# --- PostgreSQL (used by docker-compose.prod.yml) ---
POSTGRES_DB=fintrak
POSTGRES_USER=fintrak
POSTGRES_PASSWORD=change-me

# --- Backend ---
# Full connection string. Use "db:5432" as host when running inside compose,
# otherwise the host/port of your database.
DATABASE_URL=postgres://fintrak:change-me@db:5432/fintrak?sslmode=disable

# Secret used to sign auth tokens. Set a long random value, e.g.
#   openssl rand -hex 32
JWT_SECRET=

# Key used to encrypt per-user Paperless-ngx API tokens at rest. Set a long
# random value, e.g. `openssl rand -hex 32`; required when APP_ENV=production.
TOKEN_ENCRYPTION_KEY=

# Comma-separated list of origins allowed to call the API. Must include the
# exact origin(s) the frontend is served from, e.g. https://fintrak.example.com
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Base URL of the standalone statement-parser service. The backend forwards
# uploaded statement PDFs to this service over HTTP for decoupling.
STATEMENT_PARSER_URL=http://localhost:5000

# Comma-separated list of emails that are granted the 'admin' role (required to
# create/edit/delete global account types). Matched case-insensitively.
# Admin-listed addresses are reserved: self-registering one grants 'admin' only
# when the request also carries the ADMIN_SETUP_TOKEN below. Alternative path:
# register a normal account, append its email here, then restart the backend
# (existing users are promoted at startup).
ADMIN_EMAILS=

# Shared secret required to self-register an admin-listed email (see
# ADMIN_EMAILS). Generate with: openssl rand -hex 16
# While unset, admin-listed addresses cannot self-register at all.
ADMIN_SETUP_TOKEN=

# Log level for the backend: debug, info, warn, or error. Defaults to "debug"
# in development (captures HTTP request/response bodies) and "info" in
# production.
LOG_LEVEL=

# Byte cap for HTTP request/response bodies written to the log at debug level.
# Defaults to 0, which disables truncation so full bodies are captured. Set a
# positive value (e.g. 8192) to cap logged payloads.
LOG_BODY_LIMIT=

# --- Docker images (used by docker-compose.prod*.yml) ---
# Registry prefix and image tag to deploy. Images are published to GHCR.
IMAGE_REPO=ghcr.io/suyash01
IMAGE_TAG=latest
